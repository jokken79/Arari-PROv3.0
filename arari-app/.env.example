# Arari PRO v3.0 - Environment Configuration Example
# Copy this file to .env.local and fill in your values

# ============================================
# FRONTEND (Next.js)
# ============================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PORT=8000
NEXT_PUBLIC_FRONTEND_PORT=3000

# Feature Flags
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_2FA=true

# ============================================
# BACKEND (FastAPI)
# ============================================

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite:///arari_pro.db
# For PostgreSQL (production): postgresql://user:password@localhost:5432/arari_pro

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@arari-pro.local

# JWT Settings (Optional)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (Optional - for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@arari-pro.local

# Logging
LOG_LEVEL=INFO

# ============================================
# DEPLOYMENT (Production)
# ============================================

# Railway Backend
RAILWAY_API_KEY=your-railway-api-key

# Vercel Frontend
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# Codecov
CODECOV_TOKEN=your-codecov-token

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# Sentry (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# LogRocket (Session replay)
LOGROCKET_APP_ID=app-id/environment

# UptimeRobot (Uptime monitoring)
UPTIME_ROBOT_API_KEY=your-api-key
